{
  "$description": "LuMar Electric design tokens. Source of truth is :root in css/styles.css; keep in sync by hand.",
  "color": {
    "brand": {
      "orange":      { "value": "#f45b1e", "css": "--orange" },
      "orange-dark": { "value": "#d9531a", "css": "--orange-dark" },
      "orange-soft": { "value": "#fff1ea", "css": "--orange-soft" }
    },
    "neutral": {
      "ink":    { "value": "#14161a", "css": "--ink" },
      "body":   { "value": "#4a5057", "css": "--body" },
      "muted":  { "value": "#868d95", "css": "--muted" },
      "line":   { "value": "#e6e9ec", "css": "--line" },
      "hair":   { "value": "#f0f2f4", "css": "--hair" },
      "bg":     { "value": "#ffffff", "css": "--bg" },
      "bg-alt": { "value": "#f6f7f9", "css": "--bg-alt" },
      "dark":   { "value": "#0b0b0c", "css": "--dark" },
      "dark-2": { "value": "#131519", "css": "--dark-2" }
    },
    "literal": {
      "on-dark-body":   { "value": "#b9bfc6" },
      "on-dark-quiet":  { "value": "#a9b0b8" },
      "footer-text":    { "value": "#8b929a" },
      "footer-legal":   { "value": "#6d747c" },
      "error":          { "value": "#b3261e" }
    }
  },
  "font": {
    "family": "'Roboto', system-ui, -apple-system, Arial, sans-serif",
    "weights": [300, 400, 500, 700, 900],
    "size": {
      "body":    "17px",
      "body-sm": "16.5px",
      "h1": "clamp(2.1rem, 4.4vw, 3.4rem)",
      "h2": "clamp(1.8rem, 3.4vw, 3rem)",
      "h3": "clamp(1.25rem, 1.9vw, 1.6rem)",
      "h4": "clamp(1.1rem, 1.5vw, 1.32rem)",
      "lead": "clamp(1.1rem, 1.5vw, 1.3rem)",
      "eyebrow": ".78rem",
      "button": ".98rem"
    },
    "line-height": { "body": 1.62, "heading": 1.08, "lead": 1.5 },
    "tracking": { "h1": "-.028em", "h2": "-.024em", "h3": "-.014em", "label": ".06em", "eyebrow": ".16em" }
  },
  "space": {
    "gutter": { "value": "26px", "css": "--gutter" },
    "max": { "value": "1400px", "css": "--max" },
    "max-narrow": { "value": "860px" },
    "nav-h": { "value": "84px", "css": "--nav-h" },
    "section": { "value": "clamp(72px, 8vw, 132px)", "css": "--s-section" }
  },
  "radius": { "default": "0", "circle": "50%", "share-input": "3px" },
  "border": { "rule": "1px solid #e6e9ec", "heavy": "2px solid #14161a", "button": "1.5px" },
  "shadow": {
    "dropdown": "0 24px 54px rgba(12, 16, 22, .13)",
    "mobile-menu": "0 24px 46px rgba(12, 16, 22, .16)"
  },
  "motion": {
    "ease": { "value": "cubic-bezier(.22, .68, .24, 1)", "css": "--ease" },
    "duration": { "fast": ".2s", "card": ".28s", "reveal": ".8s", "band-zoom": "1.2s", "hero-cycle": "40s" }
  },
  "breakpoint": {
    "note": "Desktop-first, max-width.",
    "nav-compact": "1400px",
    "grid-2": "1240px",
    "hamburger": "1024px",
    "landing-stack": "1000px",
    "header-stack": "900px",
    "split-stack": "860px",
    "single-column": "620px"
  }
}
